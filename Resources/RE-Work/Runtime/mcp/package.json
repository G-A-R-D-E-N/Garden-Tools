{
  "name": "f4-re-mcp",
  "version": "1.0.0",
  "description": "Local MCP server exposing verified Fallout 4 engine RE facts (symbols, address-library mappings, name-confidence audit trail, vtable audits) from a pre-built SQLite index.",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "tsc",
    "build-index": "tsc && node dist/build-index.js",
    "start": "node dist/index.js",
    "test": "node ./node_modules/vitest/vitest.mjs run",
    "test:watch": "node ./node_modules/vitest/vitest.mjs",
    "dev": "tsc --watch",
    "pack": "npx --yes @anthropic-ai/mcpb pack . f4-re-mcp.mcpb"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.4",
    "better-sqlite3": "13.0.1",
    "csv-parse": "^7.0.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0",
    "vitest": "^3.2.7"
  },
  "engines": {
    "node": ">=18"
  }
}
