set(dir "${WORK_DIR}/parity-Žluť-ж")
file(REMOVE_RECURSE "${dir}")
file(MAKE_DIRECTORY "${dir}")
file(COPY "${PLUGIN}" DESTINATION "${dir}")
get_filename_component(name "${PLUGIN}" NAME)
file(WRITE "${dir}/order.tsv" "${name}\t${dir}/${name}\n")
file(WRITE "${dir}/bad.tsv" "not-a-key\tREFR\tnot-a-key\n")
function(expect code pattern)
  execute_process(COMMAND ${ARGN} RESULT_VARIABLE result OUTPUT_VARIABLE out ERROR_VARIABLE err)
  if(NOT result STREQUAL code OR NOT "${out}${err}" MATCHES "${pattern}")
    message(FATAL_ERROR "expected exit ${code} matching '${pattern}' from ${ARGN}, got (${result}):\n${out}${err}")
  endif()
endfunction()
expect(0 "picked " "${WRITEBACK}" pick "${dir}/order.tsv" "${dir}/edits.tsv")
expect(0 "" "${WRITEBACK}" apply "${dir}/order.tsv" "${dir}/edits.tsv" "${dir}/out.esp")
expect(0 "" "${DUMP}" versions "${dir}/order.tsv" "${dir}/dump")
expect(1 "error: " "${WRITEBACK}" dump "${dir}/order.tsv" "${dir}/bad.tsv" "${dir}/bad.out")
expect(2 "usage: " "${DUMP}" ba2x "${dir}/none.ba2" "none.dds")
file(WRITE "${dir}/archives.txt" "${dir}/none.ba2\r\n")
expect(0 "" "${DUMP}" ba2 "${dir}/archives.txt" "${dir}/ba2")
file(READ "${dir}/ba2/ba2_index.tsv" index)
if(NOT index MATCHES "none\\.ba2\tERROR")
  message(FATAL_ERROR "ba2 kept the list file's CR in the archive path: ${index}")
endif()
foreach(file out.esp dump/plugins.tsv)
  if(NOT EXISTS "${dir}/${file}")
    message(FATAL_ERROR "parity tools did not write ${dir}/${file}")
  endif()
endforeach()
file(STRINGS "${dir}/dump/plugins.tsv" plugins)
file(REMOVE_RECURSE "${dir}")
string(TOLOWER "${name}" lower)
if(NOT plugins MATCHES "${lower}")
  message(FATAL_ERROR "parity dump listed no ${name}: ${plugins}")
endif()
