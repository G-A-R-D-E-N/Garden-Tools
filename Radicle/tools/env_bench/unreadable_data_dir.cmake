if(CMAKE_HOST_WIN32)
  message("skipped: needs POSIX directory permissions")
  return()
endif()
set(root "${WORK_DIR}/env-bench-locked")
if(EXISTS "${root}")
  file(CHMOD "${root}" DIRECTORY_PERMISSIONS OWNER_READ OWNER_WRITE OWNER_EXECUTE)
  file(REMOVE_RECURSE "${root}")
endif()
file(MAKE_DIRECTORY "${root}/Data")
file(CHMOD "${root}" DIRECTORY_PERMISSIONS OWNER_WRITE)
if(EXISTS "${root}/Data")
  file(CHMOD "${root}" DIRECTORY_PERMISSIONS OWNER_READ OWNER_WRITE OWNER_EXECUTE)
  file(REMOVE_RECURSE "${root}")
  message("skipped: directory permissions are not enforced for this user")
  return()
endif()
execute_process(COMMAND "${BENCH}" "${root}/Data" RESULT_VARIABLE result OUTPUT_VARIABLE out ERROR_VARIABLE err)
file(CHMOD "${root}" DIRECTORY_PERMISSIONS OWNER_READ OWNER_WRITE OWNER_EXECUTE)
file(REMOVE_RECURSE "${root}")
if(NOT result STREQUAL "1" OR NOT err MATCHES "error: ")
  message(FATAL_ERROR "radicle_env_bench must report an unreadable Data folder and exit 1, got (${result}):\n${out}${err}")
endif()
