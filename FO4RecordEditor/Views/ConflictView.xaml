<Window x:Class="FO4RecordEditor.Views.ConflictView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Conflict Resolver" Height="820" Width="1320"
        Background="#1E1E1E" Foreground="#D4D4D4" WindowStartupLocation="CenterOwner">
  <Window.Resources>
    <Style x:Key="Dark" TargetType="ComboBox">
      <Setter Property="Background" Value="#252526"/>
      <Setter Property="Foreground" Value="#1E1E1E"/>
      <Setter Property="MinWidth" Value="150"/>
    </Style>
  </Window.Resources>

  <Grid Margin="8">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="2*" MinWidth="360"/>
      <ColumnDefinition Width="Auto"/>
      <ColumnDefinition Width="3*" MinWidth="480"/>
    </Grid.ColumnDefinitions>

    <!-- ============ LEFT: conflict list ============ -->
    <Grid Grid.Column="0">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>

      <TextBlock Grid.Row="0" Text="Conflicts" FontSize="14" FontWeight="SemiBold" Margin="2,0,0,6"/>

      <Grid Grid.Row="1" Margin="0,0,0,6">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <TextBox Grid.Column="0" x:Name="FilterBox" Background="#252526" Foreground="#D4D4D4" BorderBrush="#555"
                 Padding="4" TextChanged="Filter_TextChanged" ToolTip="Filter by EditorID, Type, FormKey or plugin"/>
        <CheckBox Grid.Column="1" x:Name="ModsOnly" Content="Mods only" IsChecked="True" Foreground="#D4D4D4"
                  VerticalAlignment="Center" Margin="8,0,0,0" Checked="Filter_TextChanged" Unchecked="Filter_TextChanged"/>
      </Grid>

      <DataGrid Grid.Row="2" x:Name="Grid" AutoGenerateColumns="False" IsReadOnly="True"
                CanUserAddRows="False" GridLinesVisibility="Horizontal" HeadersVisibility="Column"
                Background="#181818" Foreground="#D4D4D4" RowBackground="#1E1E1E" AlternatingRowBackground="#1B1B1B"
                BorderBrush="#3F3F46" FontFamily="Consolas" FontSize="12" SelectionMode="Single"
                SelectionChanged="Grid_SelectionChanged">
        <DataGrid.ContextMenu>
          <ContextMenu>
            <MenuItem Header="Ask AI about this conflict" Click="AskAi_Click"/>
            <MenuItem Header="Open record in tree" Click="OpenInTree_Click"/>
            <Separator/>
            <MenuItem Header="Copy FormKey" Click="CopyFormKey_Click"/>
          </ContextMenu>
        </DataGrid.ContextMenu>
        <DataGrid.Columns>
          <DataGridTextColumn Header="EditorID" Binding="{Binding EditorID}" Width="*"/>
          <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="70"/>
          <DataGridTextColumn Header="#" Binding="{Binding Count}" Width="32"/>
          <DataGridTextColumn Header="Winner" Binding="{Binding Winner}" Width="130"/>
        </DataGrid.Columns>
      </DataGrid>
    </Grid>

    <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Center" VerticalAlignment="Stretch" Background="#2D2D30"/>

    <!-- ============ RIGHT: field-level detail + resolution ============ -->
    <Grid Grid.Column="2" Margin="6,0,0,0">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <!-- identity -->
      <StackPanel Grid.Row="0" Orientation="Vertical">
        <TextBlock x:Name="DetailTitle" Text="Select a conflict to see what differs"
                   FontSize="14" FontWeight="SemiBold"/>
        <TextBlock x:Name="DetailSub" Foreground="#888" FontFamily="Consolas" FontSize="11" Margin="0,2,0,0"/>
      </StackPanel>

      <!-- field-grid toolbar -->
      <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,8,0,6">
        <CheckBox x:Name="DiffOnly" Content="Only differing fields" IsChecked="True" Foreground="#D4D4D4"
                  VerticalAlignment="Center" Checked="DiffOnly_Changed" Unchecked="DiffOnly_Changed"/>
        <Border Background="#3A2A2A" Margin="16,0,0,0" Padding="6,1"><TextBlock Text="differs" Foreground="#E06060"/></Border>
        <Border Background="#1E1E1E" Margin="6,0,0,0" Padding="6,1"><TextBlock Text="identical" Foreground="#7FB37F"/></Border>
        <TextBlock x:Name="FieldCount" VerticalAlignment="Center" Foreground="#888" Margin="16,0,0,0"/>
      </StackPanel>

      <!-- the xEdit-style matrix: Field column + one column per plugin (built in code) -->
      <DataGrid Grid.Row="2" x:Name="FieldGrid" AutoGenerateColumns="False" IsReadOnly="True"
                CanUserAddRows="False" GridLinesVisibility="All" HeadersVisibility="Column"
                Background="#181818" Foreground="#D4D4D4" RowBackground="#1E1E1E"
                BorderBrush="#3F3F46" FontFamily="Consolas" FontSize="12"
                ColumnWidth="*" EnableRowVirtualization="True">
        <DataGrid.RowStyle>
          <Style TargetType="DataGridRow">
            <Style.Triggers>
              <DataTrigger Binding="{Binding Differs}" Value="True">
                <Setter Property="Background" Value="#3A2424"/>
                <Setter Property="Foreground" Value="#F0B0B0"/>
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </DataGrid.RowStyle>
      </DataGrid>

      <!-- resolution bar -->
      <Border Grid.Row="3" Background="#252526" BorderBrush="#3F3F46" BorderThickness="1" Margin="0,8,0,0" Padding="8">
        <StackPanel Orientation="Vertical">
          <TextBlock Text="Resolve" FontWeight="SemiBold" Margin="0,0,0,6"/>
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="Make winner:" VerticalAlignment="Center" Foreground="#888" Margin="0,0,6,0"/>
            <ComboBox x:Name="WinnerCombo" Style="{StaticResource Dark}"/>
            <TextBlock Text="Patch into:" VerticalAlignment="Center" Foreground="#888" Margin="14,0,6,0"/>
            <ComboBox x:Name="PatchCombo" Style="{StaticResource Dark}" IsEditable="True"/>
            <Button Content="Resolve" Click="Resolve_Click" Padding="14,4" Margin="10,0,0,0"
                    Background="#2E7D32" Foreground="White"/>
            <Button Content="Save patch" Click="SavePatch_Click" Padding="14,4" Margin="8,0,0,0"/>
          </StackPanel>
          <TextBlock x:Name="ResolveStatus" Foreground="#7FB37F" TextWrapping="Wrap" Margin="0,6,0,0"/>
          <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
            <Button Content="Ask AI about this conflict" Click="AskAi_Click" Padding="14,4"
                    Background="#0E5C8A" Foreground="White"/>
            <Button Content="Copy report" Click="Copy_Click" Padding="14,4" Margin="8,0,0,0"/>
            <Button Content="Close" Click="Close_Click" Padding="14,4" Margin="8,0,0,0"/>
            <TextBlock x:Name="CountLabel" VerticalAlignment="Center" Foreground="#888" Margin="14,0,0,0"/>
          </StackPanel>
        </StackPanel>
      </Border>
    </Grid>
  </Grid>
</Window>
