<Window x:Class="FO4RecordEditor.Views.ConflictView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Conflict Checker" Height="760" Width="1100"
        Background="#1E1E1E" Foreground="#D4D4D4" WindowStartupLocation="CenterOwner">
  <Grid Margin="10">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <Grid Grid.Row="0" Margin="0,0,0,8">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <TextBlock Grid.Column="0" Text="Filter:" VerticalAlignment="Center" Foreground="#888" Margin="0,0,6,0"/>
      <TextBox Grid.Column="1" x:Name="FilterBox" Background="#252526" Foreground="#D4D4D4" BorderBrush="#555"
               Padding="4" TextChanged="Filter_TextChanged" ToolTip="Filter by EditorID, Type, FormKey or plugin"/>
      <CheckBox Grid.Column="2" x:Name="ModsOnly" Content="Only conflicts involving a mod" IsChecked="True"
                Foreground="#D4D4D4" VerticalAlignment="Center" Margin="12,0,12,0" Checked="Filter_TextChanged" Unchecked="Filter_TextChanged"/>
      <TextBlock Grid.Column="3" x:Name="CountLabel" VerticalAlignment="Center" Foreground="#7FB37F"/>
    </Grid>

    <DataGrid Grid.Row="1" x:Name="Grid" AutoGenerateColumns="False" IsReadOnly="True"
              CanUserAddRows="False" GridLinesVisibility="Horizontal" HeadersVisibility="Column"
              Background="#181818" Foreground="#D4D4D4" RowBackground="#1E1E1E" AlternatingRowBackground="#1B1B1B"
              BorderBrush="#3F3F46" FontFamily="Consolas" FontSize="12" SelectionMode="Extended">
      <DataGrid.Columns>
        <DataGridTextColumn Header="EditorID" Binding="{Binding EditorID}" Width="240"/>
        <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="120"/>
        <DataGridTextColumn Header="FormKey" Binding="{Binding FormKey}" Width="150"/>
        <DataGridTextColumn Header="#" Binding="{Binding Count}" Width="40"/>
        <DataGridTextColumn Header="Winner" Binding="{Binding Winner}" Width="150"/>
        <DataGridTextColumn Header="Conflicting plugins" Binding="{Binding PluginsText}" Width="*"/>
      </DataGrid.Columns>
    </DataGrid>

    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,8,0,0">
      <Button Content="Ask AI about selected" Click="AskAi_Click" Padding="14,4" Margin="0,0,8,0"
              Background="#0E5C8A" Foreground="White" ToolTip="Send the selected conflicts to the AI assistant"/>
      <TextBlock VerticalAlignment="Center" Foreground="#888"
                 Text="The AI can read each plugin's version to recommend which should win."/>
      <Button Content="Copy" Click="Copy_Click" Padding="14,4" Margin="12,0,8,0" HorizontalAlignment="Right"/>
      <Button Content="Close" Click="Close_Click" Padding="14,4"/>
    </StackPanel>
  </Grid>
</Window>
