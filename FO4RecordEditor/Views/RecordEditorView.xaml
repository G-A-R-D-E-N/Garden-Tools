<UserControl x:Class="FO4RecordEditor.Views.RecordEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:FO4RecordEditor.Views" Background="#1E1E1E">
  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    <views:ConflictCellBrush x:Key="CellBrush"/>
  </UserControl.Resources>
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <Border Grid.Row="0" x:Name="Banner" Background="#252526" BorderBrush="#3F3F46" BorderThickness="0,0,0,1" Padding="10,6">
      <StackPanel Orientation="Vertical">
        <TextBlock x:Name="BannerTitle" FontFamily="Consolas" FontSize="12" Foreground="#D4D4D4"/>
        <TextBlock x:Name="BannerStatus" FontFamily="Consolas" FontSize="12" Margin="0,2,0,0"/>
      </StackPanel>
    </Border>

    <DataGrid Grid.Row="1" x:Name="FieldList" AutoGenerateColumns="False" HeadersVisibility="Column"
            CanUserAddRows="False" CanUserDeleteRows="False" GridLinesVisibility="None"
            RowHeight="26" AlternationCount="2" AlternatingRowBackground="#1B1B1B"
            Background="#1E1E1E" Foreground="#D4D4D4" RowBackground="#1E1E1E"
            BorderBrush="#2A2A2A" BorderThickness="0"
            VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
    <DataGrid.RowStyle>
      <Style TargetType="DataGridRow">
        <Setter Property="Background" Value="Transparent"/>
        <Style.Triggers>
          <DataTrigger Binding="{Binding Differs}" Value="True">
            <Setter Property="Background" Value="#2A1E1E"/>
          </DataTrigger>
          <Trigger Property="IsMouseOver" Value="True">
            <Setter Property="Background" Value="#2A2D2E"/>
          </Trigger>
        </Style.Triggers>
      </Style>
    </DataGrid.RowStyle>
    <DataGrid.Columns>
      <DataGridTemplateColumn Header="Property" Width="320" IsReadOnly="True">
        <DataGridTemplateColumn.CellTemplate>
          <DataTemplate>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <TextBlock Text="{Binding Spacer}" FontFamily="Consolas" FontSize="12"/>
              <!-- Fixed 20px chevron slot so leaf rows align with expandable rows -->
              <Border Width="20" HorizontalAlignment="Left">
                <ToggleButton IsChecked="{Binding IsExpanded, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                              Visibility="{Binding HasChildren, Converter={StaticResource BoolToVis}}"
                              Width="16" Height="16" Cursor="Hand" HorizontalAlignment="Center">
                  <ToggleButton.Template>
                    <ControlTemplate TargetType="ToggleButton">
                      <Border Background="Transparent">
                        <TextBlock x:Name="Glyph" Text="&#xE76C;" FontFamily="Segoe MDL2 Assets"
                                   Foreground="#9DA5B4" FontSize="9"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                      </Border>
                      <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                          <Setter TargetName="Glyph" Property="Text" Value="&#xE70D;"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                          <Setter TargetName="Glyph" Property="Foreground" Value="#FFFFFF"/>
                        </Trigger>
                      </ControlTemplate.Triggers>
                    </ControlTemplate>
                  </ToggleButton.Template>
                </ToggleButton>
              </Border>
              <TextBlock Text="{Binding Node.Key}" Foreground="#9CDCFE"
                         FontFamily="Consolas" FontSize="12" VerticalAlignment="Center"/>
            </StackPanel>
          </DataTemplate>
        </DataGridTemplateColumn.CellTemplate>
      </DataGridTemplateColumn>
    </DataGrid.Columns>
    </DataGrid>
  </Grid>
</UserControl>
