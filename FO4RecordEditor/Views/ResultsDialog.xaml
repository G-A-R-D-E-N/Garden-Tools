<Window x:Class="FO4RecordEditor.Views.ResultsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Results" Height="560" Width="820"
        Background="#1E1E1E" Foreground="#D4D4D4" WindowStartupLocation="CenterOwner">
  <Grid Margin="10">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <TextBlock x:Name="HeaderLabel" Grid.Row="0" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,8"/>
    <TextBox Grid.Row="1" x:Name="Body" IsReadOnly="True" TextWrapping="NoWrap"
             Background="#0D0D0D" Foreground="#D4D4D4" FontFamily="Consolas" FontSize="12"
             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/>
    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
      <Button Content="Copy" Click="Copy_Click" Padding="14,4" Margin="0,0,8,0"/>
      <Button Content="Close" Click="Close_Click" Padding="14,4"/>
    </StackPanel>
  </Grid>
</Window>
