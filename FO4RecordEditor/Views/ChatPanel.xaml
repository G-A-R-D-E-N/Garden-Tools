<UserControl x:Class="FO4RecordEditor.Views.ChatPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:markdig="clr-namespace:Markdig.Wpf;assembly=Markdig.Wpf"
             Background="#202020">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <Border Grid.Row="0" Background="#2D2D30" Padding="8,4">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <TextBlock Grid.Column="0" Text="AI ASSISTANT" Foreground="#888" FontFamily="Consolas" FontSize="10" FontWeight="Bold" VerticalAlignment="Center"/>
        <ComboBox Grid.Column="1" x:Name="ChatSelector" Margin="10,0" Background="#1E1E1E" Foreground="#E0E0E0" BorderBrush="#555" DisplayMemberPath="Name" SelectionChanged="ChatSelector_SelectionChanged" />
        <StackPanel Grid.Column="2" Orientation="Horizontal">
          <Button Content="Rename" Click="RenameChat_Click" Padding="6,2" Margin="0,0,4,0" ToolTip="Rename this chat"/>
          <Button Content="Delete" Click="DeleteChat_Click" Padding="6,2" Margin="0,0,4,0" ToolTip="Delete this chat"/>
          <Button Content="+ New" Click="NewChat_Click" Padding="8,2" Background="#007ACC" Foreground="White" BorderThickness="0"/>
        </StackPanel>
      </Grid>
    </Border>
    <ScrollViewer Grid.Row="1" x:Name="Scroll" VerticalScrollBarVisibility="Auto" Padding="6">
      <ItemsControl x:Name="Messages">
        <ItemsControl.Resources>
            <Style TargetType="Run" x:Key="{x:Static markdig:Styles.CodeStyleKey}">
                <Setter Property="Background" Value="#444444"/>
                <Setter Property="Foreground" Value="#569CD6"/>
                <Setter Property="FontFamily" Value="Consolas"/>
            </Style>
            <Style TargetType="Paragraph" x:Key="{x:Static markdig:Styles.CodeBlockStyleKey}">
                <Setter Property="Background" Value="#1E1E1E"/>
                <Setter Property="Foreground" Value="#D4D4D4"/>
                <Setter Property="FontFamily" Value="Consolas"/>
                <Setter Property="Padding" Value="10"/>
                <Setter Property="Margin" Value="0,8,0,8"/>
            </Style>
        </ItemsControl.Resources>
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border Margin="0,4" Padding="8" CornerRadius="6"
                    Background="{Binding Bubble}">
              <markdig:MarkdownViewer Markdown="{Binding Text}" Foreground="#E0E0E0"
                                      FontFamily="Segoe UI" FontSize="13" Margin="0"/>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>
    <Grid Grid.Row="2" Background="#2D2D30">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <TextBox Grid.Column="0" x:Name="Input" Background="#1E1E1E" Foreground="#D4D4D4"
               BorderBrush="#555" Margin="4" Padding="6" AcceptsReturn="True" MinHeight="40"
               KeyDown="Input_KeyDown"/>
      <Button Grid.Column="1" x:Name="SendBtn" Content="Send" Click="Send_Click" Margin="0,4,4,4" Padding="12,4"/>
      <Button Grid.Column="1" x:Name="StopBtn" Content="Stop" Click="Stop_Click" Margin="0,4,4,4" Padding="12,4"
              Background="#8A1E1E" Foreground="White" Visibility="Collapsed"/>
    </Grid>
  </Grid>
</UserControl>
